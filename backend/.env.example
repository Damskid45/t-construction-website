# Copy this file to .env and fill in your real values before running the server.

# PostgreSQL connection (Render/local/etc.)
DATABASE_URL=postgres://username:password@localhost:5432/t_construction

# Port the API server runs on
PORT=5000

# The URL of your deployed frontend (for CORS). Add your Vercel URL once deployed.
CLIENT_ORIGIN=http://localhost:5173

# Email notifications (optional but recommended) — get a free API key at resend.com
# Without these set, the site still works, you just won't get emails when
# someone submits a job request or review (check /admin instead).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=T-Construction <onboarding@resend.dev>
NOTIFY_TO_EMAIL=your-real-email@example.com

# Cloudinary (optional but recommended) — keeps uploaded photos safe across
# redeploys. Get these free at cloudinary.com → Dashboard.
# Without these set, images are stored on local disk instead (fine for local
# development, but Render's free tier wipes local files on every redeploy).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
